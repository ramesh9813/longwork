# Single-repo monorepo: root + client + server
# Dependencies - NEVER push node_modules to GitHub
node_modules/
client/node_modules/
server/node_modules/
functions/node_modules/
.pnp
.pnp.js
.yarn/
bower_components/

# Node.js logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock
.dump/

# Environment variables - NEVER push secrets to GitHub
# Root + client (Vite) + server (Express) envs
.env
client/.env
server/.env
.env.local
client/.env.local
server/.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local
*.env
# Keep examples, ignore real secrets
!.env.example
!client/.env.example
!server/.env.example

# Firebase - keys, local emulators, debug logs
# Root + client + server
.firebase/
client/.firebase/
server/.firebase/
.firebase-hosting.*
.firestore-indexes.json
# Uncomment next line if you don't want to share project aliases with team
# .firebaserc
firebase-debug.log
firestore-debug.log
firestore-debug.log*
database-debug.log*
ui-debug.log
pubsub-debug.log
storage-debug.log
auth-debug.log
functions-debug.log
firebase-adminsdk-*.json
client/firebase-adminsdk-*.json
server/firebase-adminsdk-*.json
serviceAccountKey.json
client/serviceAccountKey.json
server/serviceAccountKey.json
service-account*.json
serviceAccount*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
client/*serviceAccount*.json
server/*serviceAccount*.json
application_default_credentials.json
gcloud-key.json
*-key.json
client/*-key.json
server/*-key.json
# Firebase web config with secrets (if you put real keys in a json file)
client/src/firebaseConfig.json
server/src/firebaseConfig.json

# Firebase Functions (if used)
functions/node_modules/
functions/lib/
functions/*.log

# Render hosting
.render/
client/.render/
server/.render/
.render_trash/
.render-buildpacks/
render.env
client/render.env
server/render.env
.render.yaml.local

# Express / uploads (local uploaded files)
uploads/
client/uploads/
server/uploads/
tmp/
temp/
client/tmp/
server/tmp/
client/temp/
server/temp/
public/uploads/
client/public/uploads/
server/public/uploads/
public/tmp/

# Build outputs - root + client + server
dist/
client/dist/
server/dist/
build/
client/build/
server/build/
out/
.next/
.nuxt/
lib/
es/
coverage/
.nyc_output/
*.tsbuildinfo
vite.config.d.ts
vite.config.js

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

